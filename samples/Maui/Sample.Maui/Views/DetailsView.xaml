<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             x:Class="Sample.Maui.Views.DetailsView">
    <Grid RowDefinitions="*,Auto">

        <idk:MarkdownView   MarkdownText="{Binding Markdown}" TextFontSize="18" Margin="8"/>

        <HorizontalStackLayout Grid.Row="1"
                           HorizontalOptions="Center"
                           Spacing="12"
                           Margin="0,0,0,20">

            <Button Text="←"
                Command="{Binding PreviousCommand}" />

            <Button Text="→"
                Command="{Binding NextCommand}" />

        </HorizontalStackLayout>

    </Grid>
</ContentView>
