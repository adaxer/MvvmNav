<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sample.Maui.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ADaxer.MvvmNav.Sample.Common.ViewModels;assembly=Sample.Common"
    xmlns:c="clr-namespace:ADaxer.MvvmNav.Maui.Views;assembly=MvvmNav.Maui"
    x:DataType="vm:ShellViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="200,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="10"
                BackgroundColor="#EEEEEE">

            <HorizontalStackLayout Spacing="10">
                <Button Text="🔙"
                        Command="{Binding GoBackCommand}" />

                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1"
        Grid.Column="0"
        BackgroundColor="#F5F5F5"
        Padding="10">

            <CollectionView ItemsSource="{Binding NavigationItems}"
                    SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavigationItem">
                        <Border Margin="0,0,0,6"
                        Padding="6"
                        BackgroundColor="Transparent">
                            <VerticalStackLayout HorizontalOptions="Fill"
                                         Spacing="0">

                                <Label Text="{Binding Title}"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label Text="{Binding Subtitle}"
                               FontSize="11"
                               TextColor="#666666"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Active Module -->
        <Grid Grid.Row="1"
              Grid.Column="1">

            <c:ContentControl BindingContext="{Binding CurrentModule}" />

            <!-- Busy Overlay -->
            <Border BackgroundColor="#80000000"
                    IsVisible="{Binding IsBusy}">

                <Label Text="Loading..."
                       TextColor="White"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <Border BackgroundColor="#80000000" Grid.RowSpan="2" Grid.ColumnSpan="2"
        IsVisible="{Binding CurrentDialog, Converter={StaticResource TruthyConverter}}">

            <c:ContentControl BindingContext="{Binding CurrentDialog}"
                      IsDialog="True" />
        </Border>
    </Grid>
</ContentPage>