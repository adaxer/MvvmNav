<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Sample.Maui.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ADaxer.MvvmNav.Sample.Common.ViewModels;assembly=Sample.Common"
    xmlns:c="clr-namespace:ADaxer.MvvmNav.Maui.Views;assembly=ADaxer.MvvmNav.Maui"
    xmlns:local="clr-namespace:Sample.Maui.Views"
    x:Name="RootPage"
    x:DataType="vm:ShellViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:NavTitleConverter x:Key="NavTitleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*"
          ColumnDefinitions="Auto,*">

        <!-- Navigation -->
        <Border Grid.Column="0"
                BackgroundColor="#F5F5F5"
                Padding="8">

            <Grid RowDefinitions="Auto,*">

                <!-- Header -->
                <VerticalStackLayout Grid.Row="0"
                                     Spacing="8">

                    <Button WidthRequest="20" Text="☰"
                            Clicked="OnHamburgerClicked" />

                    <Button WidthRequest="20" Text="🔙"
                            Command="{Binding GoBackCommand}" />
                </VerticalStackLayout>

                <!-- Menu -->
                <VerticalStackLayout Grid.Row="1"
                                Margin="0,8,0,0"
                                BindableLayout.ItemsSource="{Binding NavigationItems}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <Border Margin="0,0,0,6"
                                    Padding="6"
                                    BackgroundColor="#01000000">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Command}" />
                                </Border.GestureRecognizers>
                                
                                <VerticalStackLayout Spacing="0">
                                    <Label FontAttributes="Bold"
                                           TextColor="Black"
                                           HorizontalOptions="Fill"
                                           HorizontalTextAlignment="Start">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource NavTitleConverter}">
                                                <Binding Path="Title" />
                                                <Binding Source="{x:Reference RootPage}" Path="IsExpanded" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Subtitle}"
                                           FontSize="11"
                                           TextColor="#666666"
                                           HorizontalOptions="Fill"
                                           HorizontalTextAlignment="Start"
                                           IsVisible="{Binding Source={x:Reference RootPage}, Path=IsExpanded}">
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Active Module -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="10"
                    BackgroundColor="#EEEEEE">

                <Label Text="{Binding Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <c:ContentControl BindingContext="{Binding CurrentModule}" />

                <!-- Busy Overlay -->
                <Border BackgroundColor="#80000000"
                        IsVisible="{Binding IsBusy}">
                    <Label Text="Loading..."
                           TextColor="White"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

            </Grid>
        </Grid>

        <!-- Dialog overlay -->
        <Border Grid.ColumnSpan="2"
                BackgroundColor="#80000000"
                IsVisible="{Binding CurrentDialog, Converter={StaticResource TruthyConverter}}">
            <c:ContentControl BindingContext="{Binding CurrentDialog}"
                              IsDialog="True" />
        </Border>

    </Grid>
</ContentPage>