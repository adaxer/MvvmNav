<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ADaxer.MvvmNav.Avalonia</RootNamespace>
    <AssemblyName>ADaxer.MvvmNav.Avalonia</AssemblyName>

    <PackageId>ADaxer.MvvmNav.Avalonia</PackageId>
    <Version>0.1.0</Version>
    <Description>Avalonia library for ADaxer.MvvmNav, a lightweight MVVM navigation framework for WPF, Avalonia and .NET MAUI.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
     <PackageReference Include="ADaxer.MvvmNav.Core" />
 </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\mvvmnav.png" Pack="true" PackagePath="\" Link="mvvmnav.png" />
  </ItemGroup>

</Project>
