<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:ADaxer.MvvmNav.Wpf.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MvvmNav.Wpf;component/MvvmNav.Wpf.Resources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type v:WpfDialogWindow}">
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="5"/>
                <Setter Property="MinWidth" Value="50"/>
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
        </Style.Resources>
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="MaxWidth" Value="800"/>
        <Setter Property="MaxHeight" Value="450"/>
        <Setter Property="Background" Value="White" />
        <Setter Property="Title" Value="{Binding Title}" />
        <Setter Property="WindowStyle" Value="ToolWindow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:WpfDialogWindow}">
                    <DockPanel Background="{TemplateBinding Background}">
                        <Border DockPanel.Dock="Bottom"
                                Background="#DDD"
                                Padding="10">
                            <ItemsControl ItemsSource="{TemplateBinding EffectiveCommands}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type v:WpfDialogWindow}}, Path=ExecuteDialogCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="IsDefault" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ContentPresenter Content="{Binding}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type v:WpfDialogView}">
        <Style.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="5" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
        </Style.Resources>

        <Setter Property="MaxWidth" Value="800" />
        <Setter Property="MaxHeight" Value="450" />
        <Setter Property="Background" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:WpfDialogView}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="#888"
                        BorderThickness="1"
                        Padding="16">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom"
                                Background="#DDD"
                                Padding="10"
                                Margin="0,16,0,0">
                                <ItemsControl ItemsSource="{TemplateBinding EffectiveCommands}"
                                          HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type v:WpfDialogView}}, Path=ExecuteDialogCommand}"
                                                CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="IsDefault" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <ContentPresenter Content="{Binding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
